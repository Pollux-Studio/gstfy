{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "PORT",
    "DATABASE_URL",
    "STATUS_PORT",
    "STATUS_HOST",
    "STATUS_DATABASE_URL",
    "STATUS_PUBLIC_BASE_URL",
    "STATUS_CORS_ORIGINS",
    "STATUS_ADMIN_TOKEN",
    "STATUS_MONITORING_TOKEN",
    "STATUS_ENCRYPTION_KEY",
    "STATUS_BOOTSTRAP_ADMIN_EMAIL",
    "STATUS_BOOTSTRAP_ADMIN_PASSWORD",
    "STATUS_API_BASE_URL",
    "STATUS_WORKER_KIND",
    "STATUS_WORKER_ID",
    "STATUS_WORKER_REGION",
    "STATUS_WORKER_VERSION",
    "STATUS_WORKER_POLL_SECONDS",
    "STATUS_NOTIFICATION_POLL_SECONDS",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "SMTP_FROM",
    "STATUS_AUTO_RUN_MIGRATIONS",
    "RUN_POSTGRES_CONCURRENCY_TEST",
    "GSTFY_E2E_BASE_URL",
    "GSTFY_E2E_SKIP_WEB_SERVER",
    "GSTFY_E2E_AUTH_STATE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "dist/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
