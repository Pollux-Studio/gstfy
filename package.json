{
  "name": "gstfy",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:status-api": "pnpm --filter @gstfy/status-api dev",
    "dev:status-workers": "pnpm --filter @gstfy/status-workers dev",
    "build:status-api": "pnpm --filter @gstfy/status-api build",
    "build:status-workers": "pnpm --filter @gstfy/status-workers build",
    "test:status-api": "pnpm --filter @gstfy/status-api test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.9",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "lightningcss": "1.30.1"
    }
  }
}
