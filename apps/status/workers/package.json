{
  "name": "@gstfy/status-workers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "dev:monitoring": "tsx watch --clear-screen=false src/monitoring/worker.ts",
    "dev:notifications": "tsx watch --clear-screen=false src/notifications/worker.ts",
    "start": "node dist/index.js",
    "start:monitoring": "node dist/monitoring/worker.js",
    "start:notifications": "node dist/notifications/worker.js",
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "nodemailer": "^7.0.11",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
