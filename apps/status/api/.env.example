NODE_ENV=development
STATUS_PORT=4100
STATUS_HOST=0.0.0.0
STATUS_DATABASE_URL=postgres://postgres:postgres@localhost:5432/gstfy_status
STATUS_PUBLIC_BASE_URL=http://localhost:4100
STATUS_CORS_ORIGINS=http://localhost:3001,http://localhost:4100
STATUS_ADMIN_TOKEN=dev-status-admin-token-change-me-32chars
STATUS_MONITORING_TOKEN=dev-status-monitor-token-change-me-32chars
STATUS_ENCRYPTION_KEY=dev-status-encryption-key-change-me-32chars
STATUS_BOOTSTRAP_ADMIN_EMAIL=admin@gstfy.in
STATUS_BOOTSTRAP_ADMIN_PASSWORD=change-this-status-password
STATUS_AUTO_RUN_MIGRATIONS=true
STATUS_CREATE_DATABASE_IF_MISSING=true
STATUS_PUBLIC_CACHE_SECONDS=30
STATUS_PUBLIC_RATE_LIMIT_PER_MINUTE=120
STATUS_ADMIN_RATE_LIMIT_PER_MINUTE=60
STATUS_AUTH_RATE_LIMIT_PER_MINUTE=10
STATUS_SUBSCRIPTION_RATE_LIMIT_PER_MINUTE=10
STATUS_MONITORING_RATE_LIMIT_PER_MINUTE=600
LOG_LEVEL=info
LOG_PRETTY=auto
