NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=auto
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gstfy
AUTO_RUN_MIGRATIONS=true
WEB_ORIGIN=http://auth.localhost:3000
APP_BASE_DOMAIN=localhost:3000
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_AUTH_METHOD=
MAIL_FROM=GSTFY <no-reply@gstfy.in>
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=gstfy
R2_PUBLIC_BASE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_FORCE_PATH_STYLE=true
# Local Docker Redis: redis://localhost:6379
REDIS_URL=
QUEUE_WORKER_ENABLED=false
QUEUE_CONCURRENCY=3
QUEUE_JOB_TIMEOUT_MS=30000
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_BASE_MS=2000
OPS_ADMIN_EMAILS=
# E-invoice provider. Keep mock until IRP5 sandbox credentials are configured.
EINVOICE_PROVIDER=mock
EINVOICE_ENVIRONMENT=sandbox
EINVOICE_LIVE_ENABLED=false
IRP5_BASE_URL=
IRP5_CLIENT_ID=
IRP5_CLIENT_SECRET=
IRP5_USERNAME=
IRP5_PASSWORD=
IRP5_APP_KEY=
IRP5_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
