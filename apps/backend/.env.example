REFRESH_TOKEN_TTL_DAYS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_AUTH_METHOD=
MAIL_FROM=GSTFY <no-reply@gstfy.in>
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=gstfy
R2_PUBLIC_BASE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
