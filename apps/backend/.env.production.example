# GSTFY Backend Production Environment
# Copy these keys into Render Environment Variables.
# Do not commit real secret values.

NODE_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
AUTO_RUN_MIGRATIONS=true

# Render provides PORT automatically. Do not set PORT unless you know why.
# PORT=10000

# Neon PostgreSQL.
# Paste the real value in Render only.
DATABASE_URL=postgresql://neondb_owner:<NEON_PASSWORD>@ep-jolly-union-azfxejzd.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Public domains.
WEB_ORIGIN=https://gstfy.in
APP_BASE_DOMAIN=gstfy.in
COOKIE_DOMAIN=.gstfy.in
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Generate strong production secrets.
JWT_ACCESS_SECRET=<GENERATE_48_PLUS_RANDOM_CHARS>
CORE_POSTING_INTERNAL_KEY=<GENERATE_32_PLUS_RANDOM_CHARS>

# Token/session defaults.
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# SMTP.
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<SMTP_USER>
SMTP_PASS=<SMTP_PASSWORD>
SMTP_AUTH_METHOD=
MAIL_FROM=GSTFY <no-reply@gstfy.in>

# Firebase Admin SDK option A: Render Secret File.
# In Render, upload gstfy-dev-0e596229c2e4.json as a Secret File.
# It will be mounted at /etc/secrets/gstfy-dev-0e596229c2e4.json.
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/gstfy-dev-0e596229c2e4.json

# Firebase Admin SDK option B: Environment variables instead of a secret file.
# Use either option A or option B.
# FIREBASE_PROJECT_ID=<FIREBASE_PROJECT_ID>
# FIREBASE_CLIENT_EMAIL=<FIREBASE_CLIENT_EMAIL>
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
